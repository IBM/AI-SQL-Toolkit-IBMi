<?xml version="1.0" encoding="UTF-8"?>
<!--
  The standard jar-with-dependencies descriptor, plus the metaInf-services handler.

  The built-in descriptor keeps only one copy of each META-INF/services file, so when two
  dependencies register implementations of the same service (junit-platform-launcher and
  junit-platform-reporting both register TestExecutionListeners), all but one are silently lost.
  The handler concatenates them instead. The id is unchanged, so the jar keeps its usual name.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>jar-with-dependencies</id>
  <formats>
    <format>jar</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <containerDescriptorHandlers>
    <containerDescriptorHandler>
      <handlerName>metaInf-services</handlerName>
    </containerDescriptorHandler>
  </containerDescriptorHandlers>
  <dependencySets>
    <dependencySet>
      <outputDirectory>/</outputDirectory>
      <useProjectArtifact>true</useProjectArtifact>
      <unpack>true</unpack>
      <scope>runtime</scope>
    </dependencySet>
  </dependencySets>
</assembly>
